<Project>
	<PropertyGroup>
		<ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
	</PropertyGroup>
	<ItemGroup>
		<PackageVersion Include="DotNetProjects.Extended.Wpf.Toolkit" Version="5.0.129" />
		<PackageVersion Include="ICSharpCode.TextEditor" Version="3.2.1.6466" />
		<PackageVersion Include="Markdig.Signed" Version="1.6.0" />
		<!-- DO NOT go above 17.13.26 or the System.Memory dependency causes issues.   It can't be over v4.5.5
         in order to work properly with MSBuild. -->
		<PackageVersion Include="Microsoft.Build" Version="17.13.26" />
		<PackageVersion Include="Microsoft.Build.Framework" Version="17.13.26" />
		<PackageVersion Include="Microsoft.Build.Locator" Version="1.11.2" />
		<PackageVersion Include="Microsoft.Build.Tasks.Core" Version="17.13.26" />
		<PackageVersion Include="Microsoft.Build.Utilities.Core" Version="17.13.26" />
		<PackageVersion Include="Microsoft.CSharp" Version="4.7.0" />
		<PackageVersion Include="Microsoft.CodeAnalysis.NetAnalyzers" Version="9.0.0" />
		<PackageVersion Include="Microsoft.DiaSymReader.PortablePdb" Version="1.6.0" />
		<PackageVersion Include="Microsoft.VisualStudio.SDK" Version="17.14.40265" />
		<PackageVersion Include="Microsoft.VisualStudio.Setup.Configuration.Interop" Version="3.14.2075" />
		<PackageVersion Include="NuGet.Frameworks" Version="8.0.0" />
		<!-- Do not go above 2.1.12 as we still need .NET Framework support-->
		<PackageVersion Include="SixLabors.ImageSharp" Version="2.1.12" />
		<PackageVersion Include="System.CodeDom" Version="11.0.00" />
		<PackageVersion Include="System.ComponentModel.Composition" Version="11.0.0" />
		<PackageVersion Include="System.IO.Compression" Version="4.3.0" />
		<PackageVersion Include="System.Text.Json" Version="11.0.0" />
		<PackageVersion Include="WeCantSpell.Hunspell" Version="7.0.1" />
	</ItemGroup>
</Project>